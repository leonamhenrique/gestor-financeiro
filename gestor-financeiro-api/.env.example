DATABASE_URL="postgresql://user:password@localhost:5432/gestor_financeiro?schema=public"
# Conexão SEM pool, usada só pelas migrations (ver prisma/schema.prisma).
# Em desenvolvimento, a mesma string da DATABASE_URL. No Neon, a connection
# string "Direct connection", não a "Pooled".
DIRECT_URL="postgresql://user:password@localhost:5432/gestor_financeiro?schema=public"
# Assina os tokens de acesso. Quem tem este valor consegue entrar como
# qualquer usuário: 32+ caracteres aleatórios, nunca commitado. Gere com
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Em produção a API se recusa a subir com o valor de exemplo.
JWT_SECRET="change-me"
PORT=3000

# Origens (endereço do app) que podem chamar a API pelo navegador, separadas
# por vírgula. Em produção, só o domínio real do app.
CORS_ORIGINS="http://localhost:4173,http://localhost:5173"

# Política do cookie de sessão. strict (padrão) exige app e API no MESMO
# domínio (app.seudominio.com e api.seudominio.com contam como o mesmo).
# Em domínios diferentes — ex.: app no Cloudflare Pages e API no Render —
# use none, que obriga HTTPS. Ver src/auth/session-cookie.ts.
# COOKIE_SAMESITE="strict"

# ---- Autenticação ----
# Endereço do app, usado no link de "esqueci minha senha".
APP_URL="http://localhost:5173"
# Quem entrega os e-mails. Vazio = escreve o link no log (só desenvolvimento;
# em produção a API não sobe sem uma escolha explícita).
#   RESEND  envia de verdade, pela API do Resend (exige as duas linhas abaixo)
#   NONE    sem envio: a recuperação de senha responde que está indisponível
# MAIL_PROVIDER="RESEND"
# Chave da conta no Resend (começa com re_). Nunca commitada: ela envia e-mail
# em nome do seu domínio.
# RESEND_API_KEY=""
# Remetente. O domínio precisa estar verificado no Resend; sem domínio próprio,
# o Resend só entrega para o e-mail dono da conta.
# MAIL_FROM="Gestor Financeiro <nao-responda@seudominio.com>"

# ---- Cobrança de assinatura ----
# FAKE roda o fluxo inteiro sem chamar gateway nenhum (desenvolvimento e teste).
# Trocar para STRIPE / ASAAS / MERCADO_PAGO quando o adaptador existir.
PAYMENT_PROVIDER=FAKE

# Segredo usado para validar a assinatura do webhook. Sem ele, qualquer POST
# anônimo em /billing/webhook conseguiria liberar uma conta inadimplente.
BILLING_WEBHOOK_SECRET="change-me"

# A chave de API do gateway entra aqui quando o provedor for escolhido.
# Nunca commitar: é ela que autoriza cobrança em nome da sua conta.
# PAYMENT_PROVIDER_API_KEY=""
