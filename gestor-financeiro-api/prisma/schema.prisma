// ============================================================
// Gestor Financeiro — Schema Prisma (MVP)
// ============================================================
// Banco: PostgreSQL
// Convenções:
// - Todos os valores monetários usam Decimal (nunca Float) para evitar
//   erros de arredondamento em cálculos financeiros.
// - snake_case no banco via @@map / @map, camelCase no código TS.
// - Soft delete não incluído no MVP; pode ser adicionado depois via
//   campo `deletedAt` se for necessário histórico de exclusões.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migration não passa por pool. No Neon (e em qualquer PgBouncer), a conexão
  // "pooled" não sustenta o lock que o `migrate deploy` usa para garantir que
  // só um deploy migre por vez, e a migration falha no meio. DIRECT_URL é a
  // conexão sem pool, usada só pelo Prisma Migrate; o app continua no pool.
  // Em desenvolvimento não existe pool: deixe DIRECT_URL vazio e o Prisma usa
  // a mesma DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  APP
}

/// Como os relatórios contam uma compra no cartão.
///
/// COMPRA  — pela data do lançamento ("quando eu gastei?").
/// FATURA  — pela data de vencimento da fatura ("quando o dinheiro sai?").
///
/// As duas contagens estão certas; o que não pode é o app responder pelas
/// duas ao mesmo tempo. Era uma preferência guardada só no navegador, e por
/// isso o WhatsApp respondia sempre pelo padrão — dizendo um número enquanto
/// a tela da mesma pessoa mostrava outro. Preferência que vale em mais de uma
/// porta não cabe no localStorage de uma delas.
enum ReportRegime {
  COMPRA
  FATURA
}

enum AccountType {
  CHECKING // conta corrente
  SAVINGS // poupança
  WALLET // dinheiro / carteira física
  INVESTMENT
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
  CARRIED // paga em parte e vencida: o restante foi para a fatura seguinte
}

// Espelha os estados que qualquer gateway de assinatura expõe. PAST_DUE é o
// que dispara o bloqueio parcial: cobrança falhou, mas o gateway ainda está
// tentando — a conta não deve ser cancelada nem liberada.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE // assinatura criada mas o primeiro pagamento nunca confirmou
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionInvoiceStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  ASAAS
  MERCADO_PAGO
  FAKE // ambiente de desenvolvimento e testes, sem chamada externa
}

// ------------------------------------------------------------
// USUÁRIO
// ------------------------------------------------------------

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  passwordHash        String       @map("password_hash")
  // Bloqueio temporário contra adivinhação de senha. Fica no banco, e não em
  // memória, para valer igual com mais de uma instância da API rodando.
  // O regime dos relatórios (ver ReportRegime). FATURA é o padrão do app.
  reportRegime        ReportRegime @default(FATURA) @map("report_regime")
  failedLoginAttempts Int          @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?    @map("locked_until")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")

  bankAccounts        BankAccount[]
  categories          Category[]
  transactions        Transaction[]
  transfers           Transfer[]
  goals               Goal[]
  goalMovements       GoalMovement[]
  budgets             Budget[]
  budgetItems         BudgetItem[]
  creditCards         CreditCard[]
  subscription        Subscription?
  paymentMethods      PaymentMethod[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  transactionSeries   TransactionSeries[]
  people              Person[]
  sharedExpenses      SharedExpense[]
  pushSubscriptions   PushSubscription[]
  settlements         Settlement[]
  shareLinks          ShareLink[]
  categoryRules       CategoryRule[]
  whatsappLink        WhatsappLink?
  whatsappPairings    WhatsappPairing[]
  openFinanceConnections OpenFinanceConnection[]
  openFinanceRefusals    OpenFinanceRefusal[]

  @@map("users")
}

// ------------------------------------------------------------
// AUTENTICAÇÃO
// ------------------------------------------------------------
// Nenhum token é gravado como veio: guardamos só o SHA-256 dele. Quem ler o
// banco não consegue usar o que encontrar lá.

// Sessão de longa duração. Cada uso gera um token novo (rotação) na mesma
// `familyId`; reapresentar um token já trocado indica roubo, e a família
// inteira é revogada — o ladrão e a vítima são deslogados daquele login.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// Link de "esqueci minha senha": uso único e curta duração.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ------------------------------------------------------------
// COBRANÇA DE ASSINATURA
// ------------------------------------------------------------
// Estes modelos descrevem o que ESTE sistema precisa saber sobre a
// assinatura. A cobrança em si (tentativa, retentativa, régua de
// inadimplência) é responsabilidade do gateway — aqui só guardamos o
// reflexo do estado dele, sempre atualizado por webhook.

model Plan {
  id        String          @id @default(uuid())
  code      String          @unique // "pro-mensal" — estável, usado no código
  name      String
  amount    Decimal         @db.Decimal(14, 2)
  interval  BillingInterval @default(MONTHLY)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique @map("user_id") // uma assinatura por usuário
  planId String @map("plan_id")

  status            SubscriptionStatus @default(INCOMPLETE)
  currentPeriodEnd  DateTime?          @map("current_period_end")
  cancelAtPeriodEnd Boolean            @default(false) @map("cancel_at_period_end")

  // Identificadores do lado do gateway. São a ponte entre os dois sistemas:
  // sem eles não dá para reconciliar um webhook com o usuário local.
  provider               PaymentProvider @default(FAKE)
  providerCustomerId     String?         @map("provider_customer_id")
  providerSubscriptionId String?         @unique @map("provider_subscription_id")
  // Id da tela de pagamento hospedada, gravado ANTES de o usuário sair do
  // app. Enquanto ele paga, é a única ponte que existe: a assinatura e o
  // cliente do gateway só nascem depois, e o webhook de volta chega falando
  // deste id. Sem ele, um pagamento confirmado não teria dono.
  providerCheckoutId     String?         @unique @map("provider_checkout_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id])
  invoices SubscriptionInvoice[]

  @@index([status])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String                    @id @default(uuid())
  subscriptionId String                    @map("subscription_id")
  amount         Decimal                   @db.Decimal(14, 2)
  status         SubscriptionInvoiceStatus @default(PENDING)
  dueDate        DateTime                  @map("due_date") @db.Date
  paidAt         DateTime?                 @map("paid_at")
  failureReason  String?                   @map("failure_reason")

  providerInvoiceId String? @unique @map("provider_invoice_id")

  createdAt DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("subscription_invoices")
}

// NUNCA guarda dado de cartão. O número completo e o CVV vão do navegador
// direto para o gateway, que devolve um token — é só o token que chega aqui.
// `brand` e `last4` existem apenas para o usuário reconhecer o cartão na tela.
model PaymentMethod {
  id     String @id @default(uuid())
  userId String @map("user_id")

  provider      PaymentProvider
  providerToken String          @map("provider_token")
  brand         String? // "visa", "mastercard"
  last4         String?         @db.VarChar(4)
  expMonth      Int?            @map("exp_month")
  expYear       Int?            @map("exp_year")
  isDefault     Boolean         @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerToken])
  @@index([userId])
  @@map("payment_methods")
}

// Webhook chega mais de uma vez — o gateway reenvia quando não recebe 2xx.
// Registrar o id do evento torna o processamento idempotente: a segunda
// entrega do mesmo evento não cobra, não libera e não bloqueia de novo.
model WebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  providerEventId String          @map("provider_event_id")
  type            String
  payload         Json
  processedAt     DateTime?       @map("processed_at")
  errorReason     String?         @map("error_reason")
  createdAt       DateTime        @default(now()) @map("created_at")

  @@unique([provider, providerEventId])
  @@map("webhook_events")
}

// ------------------------------------------------------------
// CONTAS BANCÁRIAS
// ------------------------------------------------------------

model BankAccount {
  id                 String      @id @default(uuid())
  userId             String      @map("user_id")
  institutionName    String      @map("institution_name") // "Itaú", "Nubank", "Bradesco"...
  institutionLogoUrl String?     @map("institution_logo_url")
  accountType        AccountType @map("account_type")
  initialBalance     Decimal     @default(0) @map("initial_balance") @db.Decimal(14, 2)
  currentBalance     Decimal     @default(0) @map("current_balance") @db.Decimal(14, 2) // cache atualizado a cada transação
  color              String? // hex, ex: "#8A05BE" (Nubank)
  isActive           Boolean     @default(true) @map("is_active")
  // Oculta: continua valendo, mas fica fora do saldo geral e dos lançamentos
  // listados por padrão (ex: conta conjunta, reserva que não se quer ver).
  isHidden           Boolean     @default(false) @map("is_hidden")
  sortOrder          Int         @default(0) @map("sort_order") // ordem escolhida pelo usuário
  /// De qual conexão de Open Finance esta conta vem, quando vem de alguma.
  /// Nulo é o normal: conta criada à mão nunca teve conexão. Desconectar
  /// devolve a conta para esse estado, com o histórico inteiro.
  connectionId       String?     @map("connection_id")
  providerAccountId  String?     @map("provider_account_id")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection      OpenFinanceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  transactions    Transaction[]
  transfersOut    Transfer[]       @relation("TransferFrom")
  transfersIn     Transfer[]       @relation("TransferTo")
  goals           Goal[]
  goalMovements   GoalMovement[]
  creditCards     CreditCard[] // cartões vinculados a esta conta (fatura debitada daqui)
  invoicePayments InvoicePayment[] // pagamentos de fatura que saíram desta conta
  settlements     Settlement[] // acertos de despesa compartilhada que passaram por aqui

  @@unique([connectionId, providerAccountId])
  @@index([userId])
  @@index([connectionId])
  @@map("bank_accounts")
}

// ------------------------------------------------------------
// CATEGORIAS
// ------------------------------------------------------------

model Category {
  id        String          @id @default(uuid())
  userId    String?         @map("user_id") // null = categoria padrão do sistema (seed)
  name      String
  type      TransactionType
  icon      String? // nome do ícone (ex: "shopping-cart")
  color     String?
  isDefault Boolean         @default(false) @map("is_default")
  // Um nível só: a pai é sempre raiz e do mesmo tipo. Só folha recebe
  // lançamento novo (ver CategoriesService).
  parentId  String?         @map("parent_id")
  sortOrder Int             @default(0) @map("sort_order") // ordem entre irmãs
  createdAt DateTime        @default(now()) @map("created_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[]      @relation("CategoryTree")
  transactions   Transaction[]
  budgetItems    BudgetItem[]
  sharedExpenses SharedExpense[]
  categoryRules  CategoryRule[]

  // Nome único entre IRMÃS (mesmo pai, mesmo tipo), sem diferenciar
  // maiúsculas e acentos — conferido no service. "Moradia > Luz" e
  // "Escritório > Luz" são legítimas, por isso não há mais unique no banco.
  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

// ------------------------------------------------------------
// TRANSAÇÕES (núcleo do sistema)
// ------------------------------------------------------------

model Transaction {
  id                   String            @id @default(uuid())
  userId               String            @map("user_id")
  bankAccountId        String?           @map("bank_account_id") // null se for despesa de cartão
  creditCardId         String?           @map("credit_card_id") // null se for movimentação de conta
  categoryId           String            @map("category_id")
  type                 TransactionType
  amount               Decimal           @db.Decimal(14, 2)
  description          String?
  transactionDate      DateTime          @map("transaction_date") @db.Date // data definida pelo usuário
  isRecurring          Boolean           @default(false) @map("is_recurring")
  /// Dinheiro que entra ABATENDO uma despesa, em vez de ser receita.
  ///
  /// Nasceu do acerto de despesa compartilhada: quando alguém devolve a sua
  /// parte de um gasto que você pagou inteiro, esse dinheiro não é renda —
  /// você só está recebendo de volta o que adiantou. Contar como receita
  /// inflaria o seu ganho do mês com dinheiro que nunca foi seu.
  ///
  /// O lançamento continua INCOME (o dinheiro de fato entrou, e o saldo
  /// sobe), mas todo RELATÓRIO o lê como despesa negativa: ele abate a
  /// despesa original, na categoria dela. O cartão já fazia isso há muito
  /// tempo — receita no cartão é estorno e reduz a fatura; aqui a mesma
  /// ideia passa a valer para conta.
  isRefund             Boolean           @default(false) @map("is_refund")
  // Previsto (false) × confirmado (true). Só o confirmado mexe no saldo da
  // conta e no total da fatura — um previsto é intenção, não dinheiro que
  // já saiu. O padrão é `true` porque todo lançamento que já existia antes
  // deste campo já tinha sido aplicado ao saldo.
  isConfirmed          Boolean           @default(true) @map("is_confirmed")
  // Só para compra no cartão: a fatura (dia 1 do mês) em que ela entra,
  // quando não é a que a data indicaria — escolhida no lançamento ou por
  // antecipação de parcelas. A data da compra continua a real.
  invoiceMonthOverride DateTime?         @map("invoice_month_override") @db.Date
  // Série (repetição fixa ou parcelamento) e a posição nela, começando em 0.
  seriesId             String?           @map("series_id")
  seriesIndex          Int?              @map("series_index")
  // Chave de idempotência do cliente. A fila offline só tira um item dela
  // DEPOIS que a resposta chega; se o servidor gravou e a resposta se perdeu
  // no caminho, o item é reenviado — e sem esta chave o mesmo dinheiro entra
  // duas vezes. Com ela, o reenvio devolve o lançamento que já existe.
  // Nula em tudo que foi gravado antes dela e em quem não manda chave: no
  // Postgres, nulos não colidem entre si num índice único.
  clientKey            String?           @map("client_key")
  source               TransactionSource @default(APP)
  // O LOTE de importacao a que este lancamento pertence, e quando ele subiu.
  //
  // O carimbo fica em cada lancamento, e nao numa tabela de lotes a parte:
  // lista a parte envelhece -- bastaria apagar um lancamento a mao para ela
  // prometer um desfazer que ja nao bate. Assim o lote E o conjunto dos
  // lancamentos que o carregam, e a verdade esta sempre nos proprios dados.
  importBatchId        String?           @map("import_batch_id")
  importedAt           DateTime?         @map("imported_at")
  /// O id deste lançamento NO PROVEDOR de Open Finance, quando ele veio de
  /// lá. Faz duas coisas com uma chave só: sincronizar de novo reencontra o
  /// que já existe em vez de criar outro igual, e desconectar sabe o que
  /// apagar — com `providerTxId` veio do banco, sem ele é do usuário, e esse
  /// não se toca. Mesma forma do `clientKey`: nulo em tudo que não veio de
  /// fora, e no Postgres nulos não colidem entre si num índice único.
  providerTxId         String?           @map("provider_tx_id")
  syncedAt             DateTime?         @map("synced_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount   BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  creditCard    CreditCard?        @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  category      Category           @relation(fields: [categoryId], references: [id])
  series        TransactionSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  // A divisão deste gasto com outras pessoas, quando existe. Cascade: apagar
  // o lançamento apaga a divisão dele — não sobra parte de gasto nenhum.
  sharedExpense SharedExpense?
  settlement    Settlement?

  // Uma transação deve pertencer a UMA conta OU a UM cartão, nunca nenhum ou os dois.
  // Essa regra é validada na camada de aplicação (Prisma não suporta CHECK constraints
  // condicionais nativamente sem raw SQL / migration customizada).

  // Por usuário, não global: a chave nasce no aparelho de cada um, e duas
  // pessoas podem gerar a mesma sem nunca terem se visto.
  @@unique([userId, clientKey])
  @@unique([userId, providerTxId])
  // Desfazer uma importação busca todos os lançamentos de um lote.
  @@index([userId, importBatchId])
  @@index([userId, transactionDate])
  @@index([bankAccountId])
  @@index([creditCardId])
  @@index([categoryId])
  @@index([seriesId])
  @@map("transactions")
}

/// Transferência entre contas do próprio usuário.
///
/// NÃO é um lançamento, e é por isso que existe como tabela própria. Mover
/// dinheiro da conta A para a conta B não é receita nem despesa: o patrimônio
/// é o mesmo antes e depois. Se fosse um par de Transactions (saída em A,
/// entrada em B), ela entraria em TODO relatório de receita e despesa — mapa
/// de calor, categorias, resultado do mês, fluxo de caixa, insights — e cada
/// um deles precisaria de uma exceção para expulsá-la. Separada, ela
/// simplesmente nunca aparece lá, porque nunca foi lançamento.
///
/// Por isso também não tem `categoryId`: categoria classifica para onde o
/// dinheiro foi, e aqui ele não foi a lugar nenhum.
model Transfer {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  amount        Decimal  @db.Decimal(14, 2)
  description   String?
  transferDate  DateTime @map("transfer_date") @db.Date
  /// Previsto (false) × confirmado (true). Só o confirmado mexe no saldo das
  /// duas contas — previsto é intenção, e intenção não move dinheiro.
  isConfirmed   Boolean  @default(true) @map("is_confirmed")
  /// Mesma chave de idempotência dos lançamentos: a fila offline só tira o
  /// item dela depois da resposta, e sem a chave um reenvio transferiria o
  /// mesmo dinheiro duas vezes.
  clientKey     String?  @map("client_key")
  /// O lote de importação que a criou, quando veio de um extrato. É por ele
  /// que "Desfazer esta importação" alcança a transferência: sem isso o
  /// desfazer deixaria o dinheiro mexido entre as duas contas.
  importBatchId String?   @map("import_batch_id")
  importedAt    DateTime? @map("imported_at")
  /// O id da transação NO PROVEDOR, como nos lançamentos. É o que impede a
  /// linha de voltar como novidade na sincronização seguinte.
  providerTxId  String?   @map("provider_tx_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount BankAccount @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   BankAccount @relation("TransferTo", fields: [toAccountId], references: [id])

  // Origem e destino diferentes é regra de aplicação: o Prisma não tem CHECK
  // condicional nativo, e a mesma validação precisa existir no serviço de
  // qualquer forma, para devolver mensagem em português.

  @@unique([userId, clientKey])
  @@index([userId, transferDate])
  @@index([userId, importBatchId])
  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

/// Planejamento de um mês: quanto a pessoa espera receber, quanto se permite
/// gastar, e o teto de cada categoria.
///
/// Guarda só a INTENÇÃO. O quanto já foi gasto não mora aqui: ele é recontado
/// na leitura, a partir dos lançamentos e da configuração de exibição de
/// relatório (por data de compra ou por vencimento da fatura), que é escolha
/// do aparelho. Gravar o realizado seria gravar a resposta de ontem para uma
/// pergunta que muda a cada lançamento novo — e a cada troca daquela
/// configuração.
model Budget {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  /// "AAAA-MM". Mês é o grão do planejamento, então o mês é a chave.
  month     String   @db.VarChar(7)
  /// Receita que a pessoa ESPERA no mês. Não é a receita lançada — serve de
  /// referência para a sugestão dos 80% e para a tela comparar as duas.
  income    Decimal  @default(0) @db.Decimal(14, 2)
  /// Teto de gasto do mês inteiro. As metas por categoria são repartição
  /// dele, nunca soma por cima.
  total     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  items BudgetItem[]

  @@unique([userId, month])
  @@index([userId])
  @@map("budgets")
}

/// Meta de uma categoria dentro de um planejamento.
model BudgetItem {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  budgetId     String   @map("budget_id")
  categoryId   String   @map("category_id")
  amount       Decimal  @db.Decimal(14, 2)
  /// "Usar total das subcategorias": a meta do pai é a soma das filhas e se
  /// recalcula sozinha quando uma filha muda. O valor fica gravado mesmo
  /// assim — quem lê a lista não precisa refazer a conta, e desmarcar a opção
  /// deixa o número de partida certo.
  fromChildren Boolean  @default(false) @map("from_children")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([budgetId, categoryId])
  @@index([userId])
  @@index([categoryId])
  @@map("budget_items")
}

enum GoalMovementType {
  DEPOSIT // aplicar: sai da conta, entra no objetivo
  WITHDRAW // resgatar: sai do objetivo, volta para uma conta
}

/// Objetivo de poupança: uma meta com prazo e um dinheiro guardado para ela.
///
/// O saldo do objetivo tem DUAS origens, e elas não se misturam de propósito:
///
///   initialBalance  dinheiro que já era do usuário ANTES de cadastrar o
///                   objetivo e que nunca passou pelas contas do app. Conta
///                   para o progresso da meta e para NADA mais — não entra no
///                   saldo geral, senão cadastrar um objetivo criaria dinheiro.
///   movimentos      aplicações e resgates. Esses saíram (ou voltaram para)
///                   uma conta de verdade, então continuam contando no saldo
///                   geral: guardar dinheiro não pode parecer ficar mais pobre.
model Goal {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  name           String
  startDate      DateTime  @map("start_date") @db.Date
  targetDate     DateTime  @map("target_date") @db.Date
  targetAmount   Decimal   @map("target_amount") @db.Decimal(14, 2)
  initialBalance Decimal   @default(0) @map("initial_balance") @db.Decimal(14, 2)
  /// Conta sugerida ao aplicar e ao resgatar. Sugestão, não trava: o dinheiro
  /// pode vir de outra conta no dia em que vier.
  accountId      String?   @map("account_id")
  /// Concluído sai das escolhas de aplicar e resgatar, mas continua na lista
  /// e guarda o que tem: concluir é terminar, não apagar.
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   BankAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  movements GoalMovement[]

  @@index([userId, targetDate])
  @@index([accountId])
  @@map("goals")
}

/// Uma aplicação ou um resgate. É o que move dinheiro entre uma conta e um
/// objetivo — e, como a transferência, não é receita nem despesa: o
/// patrimônio não muda, só o lugar onde ele está.
model GoalMovement {
  id            String           @id @default(uuid())
  userId        String           @map("user_id")
  goalId        String           @map("goal_id")
  bankAccountId String           @map("bank_account_id")
  type          GoalMovementType
  amount        Decimal          @db.Decimal(14, 2)
  description   String?
  movementDate  DateTime         @map("movement_date") @db.Date
  clientKey     String?          @map("client_key")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@unique([userId, clientKey])
  @@index([userId, movementDate])
  @@index([goalId])
  @@index([bankAccountId])
  @@map("goal_movements")
}

enum SeriesKind {
  FIXED // repete o mesmo lançamento (aluguel, assinatura)
  INSTALLMENT // parcelamento de uma compra: "parcela i de N"
}

enum SeriesFrequency {
  BIWEEKLY // a cada 15 dias
  MONTHLY
  QUARTERLY
  YEARLY
}

// O que as ocorrências de uma série têm em comum. Cada ocorrência é um
// Transaction normal (com saldo/fatura próprios) que aponta para cá.
model TransactionSeries {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  kind      SeriesKind
  frequency SeriesFrequency
  count     Int // quantas ocorrências foram criadas
  createdAt DateTime        @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
  @@map("transaction_series")
}

// ------------------------------------------------------------
// CARTÕES DE CRÉDITO
// ------------------------------------------------------------

model CreditCard {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  bankAccountId String?  @map("bank_account_id") // conta de onde a fatura é debitada (opcional)
  name          String // "Nubank Roxinho", "Itaú Click"
  limitAmount   Decimal  @map("limit_amount") @db.Decimal(14, 2)
  closingDay    Int      @map("closing_day") // 1-31
  dueDay        Int      @map("due_day") // 1-31
  color         String?
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order") // ordem escolhida pelo usuário
  /// Mesma ideia da conta: nulo até alguém conectar, e nulo de novo depois
  /// de desconectar — o cartão e as compras dele continuam onde estavam.
  connectionId  String?  @map("connection_id")
  providerAccountId String? @map("provider_account_id")
  /// Os dias que o BANCO reporta, lidos das faturas dele na sincronização.
  /// Nulos até a primeira leitura, e nulos para cartão que não veio do Open
  /// Finance. Guardados porque antes eram lidos, usados na tela de conferir
  /// e jogados fora — e aí nenhuma outra tela sabia o que o banco tinha dito.
  bankClosingDay Int?    @map("bank_closing_day")
  bankDueDay     Int?    @map("bank_due_day")
  /// O ciclo deste cartão está como uma PESSOA quis, e não como o banco diz.
  /// Enquanto for falso, os dias do banco são aplicados sozinhos: não há
  /// decisão humana para respeitar. Vira verdadeiro quando alguém grava dias
  /// que discordam do banco, e volta a falso quando voltam a concordar.
  cycleEditedByUser Boolean @default(false) @map("cycle_edited_by_user")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount?             @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  connection   OpenFinanceConnection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  invoices     CreditCardInvoice[]
  cycles       CreditCardBillingCycle[]

  @@unique([connectionId, providerAccountId])
  @@index([userId])
  @@index([connectionId])
  @@map("credit_cards")
}

/// Os dias de fechamento e vencimento VALEM A PARTIR de uma fatura, e não
/// para sempre. Banco deixa mudar o vencimento (no Itaú, de seis em seis
/// meses), e quando ele muda o fechamento vem junto — mas só dali para a
/// frente: o que já fechou, foi pago ou venceu continua com as datas que
/// teve. Um par de dias por cartão não consegue dizer isso, e era por isso
/// que `updateBillingCycle` proibia a troca depois da primeira fatura.
///
/// `validFrom` é o mês de REFERÊNCIA da primeira fatura que usa estes dias
/// (sempre dia 1). Cartão que nunca mudou tem uma linha só, com 1900-01-01:
/// "desde sempre". As colunas `closingDay`/`dueDay` do cartão continuam
/// existindo como o período de AGORA — é o que quase toda leitura precisa, e
/// guardar o atual em dois lugares é melhor do que fazer cada uma delas
/// percorrer a linha do tempo para descobrir o óbvio.
model CreditCardBillingCycle {
  id           String   @id @default(uuid())
  creditCardId String   @map("credit_card_id")
  validFrom    DateTime @map("valid_from") @db.Date // dia 1 do mês de referência
  closingDay   Int      @map("closing_day")
  dueDay       Int      @map("due_day")
  createdAt    DateTime @default(now()) @map("created_at")

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, validFrom])
  @@index([creditCardId])
  @@map("credit_card_billing_cycles")
}

// ------------------------------------------------------------
// FATURAS DE CARTÃO
// ------------------------------------------------------------

model CreditCardInvoice {
  id             String        @id @default(uuid())
  creditCardId   String        @map("credit_card_id")
  referenceMonth DateTime      @map("reference_month") @db.Date // sempre dia 1 do mês, ex: 2026-09-01
  totalAmount    Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  status         InvoiceStatus @default(OPEN)
  closingDate    DateTime      @map("closing_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  // Preenchido quando os pagamentos cobrem o devido (registro/consulta em
  // massa). A regra de verdade é calculada em `invoice-statement.ts`.
  paidAt         DateTime?     @map("paid_at")
  // A fatura foi VIRADA neste dia: fechou antes de `closingDate`, como o
  // "Virar fatura" do Itaú/Iti. NÃO substitui `closingDate` — o vencimento
  // é calculado comparando com o fechamento do calendário, e trocar um pelo
  // outro adianta o vencimento em um mês (ver billing-cycle.ts). Serve para
  // duas perguntas só: a fatura ainda está aberta, e uma compra desta data
  // cai nela ou na seguinte.
  earlyClosedAt  DateTime?     @map("early_closed_at") @db.Date
  createdAt      DateTime      @default(now()) @map("created_at")

  creditCard CreditCard       @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  payments   InvoicePayment[]

  @@unique([creditCardId, referenceMonth])
  @@index([creditCardId])
  @@map("credit_card_invoices")
}

// Um pagamento de fatura. Uma fatura aceita vários (pagamento parcial em
// partes). Cada um sai de uma conta bancária e debita o saldo dela na mesma
// transação de banco. Não é um lançamento (Transaction): não tem categoria
// e não é gasto novo — é o pagamento de compras que já foram contadas.
model InvoicePayment {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  bankAccountId String   @map("bank_account_id")
  amount        Decimal  @db.Decimal(14, 2)
  paidAt        DateTime @map("paid_at") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  invoice     CreditCardInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  // Restrict: conta com pagamento registrado é histórico e só é arquivada,
  // nunca apagada (ver BankAccountsService.delete).
  bankAccount BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([bankAccountId])
  @@map("invoice_payments")
}

// ------------------------------------------------------------
// DESPESAS COMPARTILHADAS
// ------------------------------------------------------------
// Dividir um gasto com alguém não cria dinheiro novo, e acertar a conta
// depois não é receita: é dívida sendo quitada. Por isso NADA aqui vira
// Transaction — é o mesmo motivo que deu tabela própria à Transferência.
// Um acerto que fosse Transaction entraria em todo relatório de receita e
// despesa, e cada um precisaria de uma exceção para expulsá-lo.
//
// O saldo de cada pessoa NÃO é guardado em lugar nenhum. Ele é a conta:
//
//   Σ(parte dela nas que eu paguei)
//   − Σ(minha parte nas que ela pagou)
//   − Σ(acertos recebidos dela)
//   + Σ(acertos pagos a ela)
//
// Guardar esse número seria mais um saldo para sair do ar com o resto.

enum SettlementDirection {
  RECEIVED // a pessoa me pagou
  PAID // eu paguei a pessoa
}

/// Alguém com quem se divide gasto. Não é usuário do app nem tem login:
/// é um nome na agenda de quem divide.
model Person {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  // Só para aparecer na página pública ("copiar chave Pix"). É dado de
  // contato, não meio de pagamento: o app não cobra ninguém.
  pixKey    String?  @map("pix_key")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares       ExpenseShare[]
  expensesPaid SharedExpense[] // as que ELA pagou
  settlements  Settlement[]
  shareLinks   ShareLink[]

  @@index([userId])
  @@map("people")
}

/// Um gasto dividido. Existe em duas formas, e exatamente uma delas:
///
///   EU PAGUEI    `transactionId` aponta para o lançamento real. Ele é a
///                verdade sobre valor, data, descrição e categoria — aqui
///                não se repete nada disso, para não haver duas versões do
///                mesmo número.
///   ELA PAGOU    `paidByPersonId` diz quem pagou, e os campos descritivos
///                são preenchidos AQUI. Não há lançamento nenhum: o dinheiro
///                não passou por conta nem cartão meu. É a linha "fora da
///                conta" do extrato.
///
/// Nunca as duas, nunca nenhuma — a mesma convenção XOR que Transaction já
/// usa entre conta e cartão, conferida na camada de aplicação.
model SharedExpense {
  id             String  @id @default(uuid())
  userId         String  @map("user_id")
  transactionId  String? @unique @map("transaction_id")
  paidByPersonId String? @map("paid_by_person_id")

  // Só na forma "ela pagou". Na outra, vêm do lançamento.
  description String?
  amount      Decimal?  @db.Decimal(14, 2)
  expenseDate DateTime? @map("expense_date") @db.Date
  categoryId  String?   @map("category_id")

  clientKey String?  @map("client_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  // Restrict: pessoa que já pagou alguma coisa é histórico, e só é
  // arquivada (isActive = false), nunca apagada.
  paidBy      Person?        @relation(fields: [paidByPersonId], references: [id], onDelete: Restrict)
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  shares      ExpenseShare[]

  @@unique([userId, clientKey])
  @@index([userId])
  @@index([paidByPersonId])
  @@map("shared_expenses")
}

/// A parte de UMA pessoa em um gasto dividido.
///
/// A minha parte não tem linha aqui: ela é `total − Σ(partes dos outros)`.
/// Guardada, seria o quarto número a ter de bater com os outros três; e um
/// arredondamento de centavo em qualquer lado abriria uma diferença que
/// ninguém consegue explicar olhando a tela.
model ExpenseShare {
  id              String   @id @default(uuid())
  sharedExpenseId String   @map("shared_expense_id")
  personId        String   @map("person_id")
  amount          Decimal  @db.Decimal(14, 2)
  // Guardado só quando a divisão foi FEITA por percentual, para a tela
  // poder mostrar "50%" em vez de recalcular e exibir 49,99%.
  percent         Decimal? @db.Decimal(7, 4)
  createdAt       DateTime @default(now()) @map("created_at")

  sharedExpense SharedExpense @relation(fields: [sharedExpenseId], references: [id], onDelete: Cascade)
  person        Person        @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@unique([sharedExpenseId, personId])
  @@index([personId])
  @@map("expense_shares")
}

/// Um acerto: dinheiro que trocou de mão para abater dívida.
///
/// Mexe em saldo de conta quando tem `bankAccountId`, pelo mesmo caminho
/// atômico de todo o resto (increment/decrement dentro de $transaction).
/// Mas não é receita nem despesa e não tem categoria — não há "para onde o
/// dinheiro foi": ele voltou para quem já era dono dele.
model Settlement {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  /// O lançamento que representa este acerto no extrato, quando ele deve
  /// aparecer lá. Com ele, é o LANÇAMENTO que mexe no saldo e entra nos
  /// relatórios, e o acerto não mexe em nada sozinho — senão o dinheiro
  /// andaria duas vezes.
  ///
  /// Existe porque pagar a alguém o que ela adiantou por você É uma despesa
  /// sua: o dinheiro sai da sua conta e o consumo foi seu. Sem isto, saíam
  /// 500 do banco e nenhum relatório via a despesa.
  ///
  /// Nulo quando o acerto é só um abate de dívida — dinheiro vivo, ou quem
  /// prefere não ver a linha no extrato.
  transactionId String?             @unique @map("transaction_id")
  personId      String              @map("person_id")
  direction     SettlementDirection
  amount        Decimal             @db.Decimal(14, 2)
  settledAt     DateTime            @map("settled_at") @db.Date
  // Nulo quando o acerto não passou por conta cadastrada (dinheiro vivo).
  bankAccountId String?             @map("bank_account_id")
  description   String?
  clientKey     String?             @map("client_key")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      Person       @relation(fields: [personId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  // Cascade: apagar o lançamento apaga o acerto que ele representava — o
  // dinheiro deixou de existir no extrato, e a dívida volta ao que era.
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([userId, clientKey])
  @@index([userId, settledAt])
  @@index([personId])
  @@map("settlements")
}

/// Link de leitura para mostrar a conta a quem deve (ou a quem me deve).
///
/// O token em claro existe uma vez só, na resposta da criação. Aqui fica o
/// SHA-256 dele — quem ler o banco não consegue usar o que encontrar, igual
/// aos tokens de sessão.
///
/// Esta tabela é a ÚNICA do módulo FORA do RLS, e de propósito: a rota
/// pública não tem dono para o banco ler, então precisa conseguir resolver
/// o token antes de saber de quem ele é. Só guarda hash, data e dois ids.
model ShareLink {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  personId     String    @map("person_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  lastViewedAt DateTime? @map("last_viewed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([personId])
  @@map("share_links")
}

// ============================================================
// O que o usuario ensinou sobre um lojista.
// ============================================================
// Extrato bancario e repetitivo: o mesmo punhado de lojistas todo mes. Medido
// num extrato real do Nubank, 44 de 74 linhas eram do mesmo marketplace. Uma
// regra aprendida cobre 59% do arquivo -- por isso isto e memoria, e nao
// adivinhacao.
//
// `merchant` e a CHAVE do lojista, ja normalizada pelo cliente (minusculas,
// sem acento e sem pontuacao) e podada do sufixo de parcela. Ela pode ser um
// PREFIXO: "mercadolivre" casa com "mercadolivreeritecha". Quando mais de uma
// regra casa, vence a mais longa -- a mais especifica.
model CategoryRule {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  merchant   String
  // O nome como o extrato escreveu: "Marte Paes", "Edd Acai".
  //
  // `merchant` e a chave e precisa ser normalizada -- e o que faz "MARTE
  // PAES" e "marte paes" serem o mesmo lojista. Mas chave nao se mostra a
  // ninguem: "martepaes" na tela e o app devolvendo ao usuario o jeito como
  // ele guarda, nao o jeito como a pessoa escreveu.
  //
  // Antes o nome era DERIVADO dos lancamentos do usuario. Funcionava ate os
  // lancamentos nao existirem -- regra importada cujo lote se perdeu, ou
  // lancamentos apagados -- e ai a lista mostrava a chave crua.
  //
  // Nula nas regras gravadas antes desta coluna: a tela cai no nome derivado
  // e, sem ele, na chave. Ensinar o lojista de novo preenche.
  label      String?
  categoryId String   @map("category_id")
  // Quantas importacoes ja confirmaram a regra. Nao decide nada hoje; existe
  // para a tela poder dizer de onde veio o palpite.
  hits       Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  // Um lojista tem uma categoria so. Ensinar de novo troca a que valia, em
  // vez de empilhar duas regras que brigam.
  @@unique([userId, merchant])
  @@index([userId])
  @@map("category_rules")
}

// ============================================================
// O numero de WhatsApp que pode lancar nesta conta.
// ============================================================
// O webhook recebe uma mensagem e precisa saber de QUEM ela e antes de
// qualquer outra coisa. Numero nao pareado nao lanca nada: qualquer pessoa
// pode mandar mensagem para o numero da API, e sem este vinculo a primeira
// delas estaria escrevendo no extrato de alguem.
//
// O telefone NAO e guardado em claro. Telefone tem pouca entropia -- um
// celular brasileiro cabe em 10^11 tentativas --, e um SHA-256 puro disso se
// reverte por forca bruta em minutos. Por isso `phoneHash` e um HMAC com um
// segredo do servidor (WHATSAPP_PHONE_PEPPER): quem levar so o banco nao tem
// como descobrir os numeros. Trocar ou perder o segredo invalida os vinculos
// e todo mundo pareia de novo -- e o preco de nao guardar o numero legivel.
//
// `phoneLast4` existe para a tela poder dizer QUAL numero esta ligado sem
// mostrar o numero inteiro: "termina em 4321". E o mesmo acordo do cartao,
// onde o app guarda bandeira e ultimos quatro e nunca o PAN.
/// Uma autorização de Open Finance: um banco, um usuário, um consentimento.
///
/// Existe como tabela, e não como colunas da conta, porque um consentimento
/// é de um BANCO e traz várias contas e cartões de uma vez — e porque ele
/// tem vida própria: nasce esperando autorização, vive meses, expira, é
/// revogado, enquanto a conta do app existe antes, durante e depois.
///
/// `revokedAt` em vez de apagar: os lançamentos que entraram por ela
/// continuam existindo depois de desconectar — desistir da integração não
/// apaga o dinheiro de ninguém. Apagar a linha deixaria esse passado sem
/// explicação.
///
/// O conectar é sempre opcional: quem nunca conectar nada no app não tem
/// nenhuma linha aqui, e nada no sistema se comporta diferente por isso.
/// Um aparelho que pediu para ser avisado quando chegar lançamento novo.
///
/// Uma linha por APARELHO, não por pessoa: quem usa o app no telefone e no
/// computador tem duas, e avisar só numa seria avisar onde ela talvez não
/// esteja.
model PushSubscription {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  /// A URL que o serviço de push do navegador deu. É ela que identifica o
  /// aparelho, e por isso é única.
  endpoint String @unique
  /// As chaves que o PRÓPRIO navegador gerou para cifrar o aviso. Sem elas
  /// o payload não se monta; fora deste endpoint elas não abrem nada.
  p256dh   String
  auth     String
  /// Para a regra de no máximo um aviso por dia. No banco, e não em
  /// memória: duas instâncias da API acordando às 6h mandariam dois.
  ultimoAvisoEm DateTime? @map("ultimo_aviso_em")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model OpenFinanceConnection {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  /// Qual intermediário. Hoje só existe "POLP"; a coluna existe para que
  /// trocar de provedor não seja uma migração de dados.
  provider        String    @default("POLP")
  /// O id do consentimento NO PROVEDOR — por ele se lê, se confere o status
  /// e se revoga lá fora.
  consentId       String    @map("consent_id")
  institutionId   String    @map("institution_id")
  /// Gravado de propósito, em vez de buscado a cada tela: o catálogo do
  /// provedor muda, e uma conexão antiga tem de continuar sabendo dizer de
  /// que banco ela era.
  institutionName String?   @map("institution_name")
  status          String
  products        String[]  @default([])
  /// Quando a autorização concluiu. Nulo enquanto espera o banco — e é só
  /// a partir daí que o provedor cobra.
  authorizedAt    DateTime? @map("authorized_at")
  lastSyncedAt    DateTime? @map("last_synced_at")
  /// Quantos lançamentos esperam conferência, contados pelo trabalho
  /// diário. A tela lê daqui em vez de perguntar ao provedor a cada abertura
  /// do app — seriam centenas de transações baixadas para, na maioria das
  /// vezes, não mostrar nada.
  ///
  /// Nulo é "ainda não perguntei", que é diferente de zero, "perguntei e não
  /// havia nada". Só o zero autoriza a tela a ficar calada.
  pendingCount     Int?      @map("pending_count")
  pendingCheckedAt DateTime? @map("pending_checked_at")
  /// Quando a pessoa VIU a lista pela última vez. Daí para a frente,
  /// novidade é o que o provedor recebeu depois disso.
  pendingSeenAt   DateTime? @map("pending_seen_at")
  /// Quantos chegaram DEPOIS de ela ter visto. É este o número que o aviso
  /// usa: o total inclui doze meses de histórico que ela pode nunca querer.
  pendingNewCount Int?      @map("pending_new_count")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts BankAccount[]
  creditCards  CreditCard[]

  /// O mesmo consentimento não entra duas vezes: uma segunda sincronização
  /// criaria outra conexão, e as contas ficariam divididas entre as duas.
  @@unique([provider, consentId])
  @@index([userId])
  @@map("open_finance_connections")
}

/// O que a pessoa recusou não volta sozinho.
///
/// Nasceu de um defeito medido: desfiz um lote que tinha entrado
/// automaticamente, reabri a tela, e os mesmos lançamentos entraram de
/// novo. A condição "não casa com nada que você já tem" olha o que o app
/// TEM — e depois do desfazer ele não tem mais. Nada registrava a recusa.
///
/// Guarda o id do lançamento NO PROVEDOR, e nada mais: para lembrar que
/// alguém não quis, basta saber qual era. Vale para a entrada automática e
/// para a proposta — recusado some das duas.
model OpenFinanceRefusal {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  providerTxId String   @map("provider_tx_id")
  refusedAt    DateTime @default(now()) @map("refused_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Recusar duas vezes é a mesma recusa.
  @@unique([userId, providerTxId])
  @@index([userId])
  @@map("open_finance_refusals")
}

model WhatsappLink {
  id         String    @id @default(uuid())
  // Um vinculo por usuario: a pessoa fala de um numero so.
  userId     String    @unique @map("user_id")
  // E um usuario por numero: sem isto, uma mensagem resolveria para dois
  // donos e o lancamento cairia na conta errada.
  phoneHash  String    @unique @map("phone_hash")
  phoneLast4 String    @map("phone_last4")
  linkedAt   DateTime  @default(now()) @map("linked_at")
  // Ultima mensagem aceita deste numero. Serve a tela ("em uso desde..."), e
  // a nada mais: nao e historico de conversa, que este app nao guarda.
  lastSeenAt DateTime? @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_links")
}

// O codigo que liga um numero a uma conta, uma vez so.
//
// Nasce na tela do app, ja logada -- e por isso que ele prova que quem mandou
// a mensagem e o dono da conta. Vai para o WhatsApp pela mao do usuario e
// morre no primeiro uso.
//
// Guardado como SHA-256, como todo token deste schema. Aqui o hash puro basta
// porque o codigo e aleatorio de verdade (8 caracteres de um alfabeto de 32,
// ~10^12 combinacoes), e nao um numero de telefone.
model WhatsappPairing {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("whatsapp_pairings")
}
